+/**
+ * Replace the value of an HTTP request header from the next request on,
+ * in every request that already carries a header of that name (matched
+ * case-insensitively). Requests without it are left alone. This lets an
+ * application renew credentials, such as an expired access token, under
+ * streams that are already open.
+ *
+ * Thread safe. Up to 8 headers can be overridden at once.
+ *
+ * @param name  header name, without the colon
+ * @param value new header value, or NULL to remove the override
+ * @return 0 on success, a negative AVERROR code on failure
+ */
+int av_http_set_header_override(const char *name, const char *value);
