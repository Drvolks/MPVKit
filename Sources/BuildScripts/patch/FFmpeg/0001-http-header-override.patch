+/* Header values set by the application while requests are in flight, for
+ * example a renewed access token. Each one replaces the header of the same
+ * name in later requests that already carry it; it is never added to a
+ * request that doesn't. */
+#define MAX_HEADER_OVERRIDES 8
+static AVMutex header_override_lock = AV_MUTEX_INITIALIZER;
+static char *header_override_names[MAX_HEADER_OVERRIDES];
+static char *header_override_values[MAX_HEADER_OVERRIDES];
+
+int av_http_set_header_override(const char *name, const char *value)
+{
+    int i, free_slot = -1, ret = 0;
+
+    if (!name || !*name || strpbrk(name, ":\r\n") || (value && strpbrk(value, "\r\n")))
+        return AVERROR(EINVAL);
+
+    ff_mutex_lock(&header_override_lock);
+    for (i = 0; i < MAX_HEADER_OVERRIDES; i++) {
+        if (header_override_names[i] && !av_strcasecmp(header_override_names[i], name))
+            break;
+        if (!header_override_names[i] && free_slot < 0)
+            free_slot = i;
+    }
+    if (i == MAX_HEADER_OVERRIDES) {
+        if (!value)
+            goto end;
+        if (free_slot < 0) {
+            ret = AVERROR(ENOSPC);
+            goto end;
+        }
+        i = free_slot;
+        header_override_names[i] = av_strdup(name);
+        if (!header_override_names[i]) {
+            ret = AVERROR(ENOMEM);
+            goto end;
+        }
+    }
+    av_freep(&header_override_values[i]);
+    if (value)
+        header_override_values[i] = av_strdup(value);
+    if (!header_override_values[i]) {
+        av_freep(&header_override_names[i]);
+        if (value)
+            ret = AVERROR(ENOMEM);
+    }
+end:
+    ff_mutex_unlock(&header_override_lock);
+    return ret;
+}
+
+/* Writes the custom headers (CRLF-terminated lines), swapping in the
+ * override value of any header that has one. */
+static void print_custom_headers(AVBPrint *request, const char *headers)
+{
+    const char *line = headers;
+
+    ff_mutex_lock(&header_override_lock);
+    while (*line) {
+        const char *end = strstr(line, "\r\n");
+        size_t len = end ? (size_t)(end - line) + 2 : strlen(line);
+        int i, replaced = 0;
+
+        for (i = 0; i < MAX_HEADER_OVERRIDES && !replaced; i++) {
+            const char *name = header_override_names[i];
+            size_t name_len;
+            if (!name)
+                continue;
+            name_len = strlen(name);
+            if (len > name_len && line[name_len] == ':' &&
+                !av_strncasecmp(line, name, name_len)) {
+                av_bprintf(request, "%s: %s\r\n", name, header_override_values[i]);
+                replaced = 1;
+            }
+        }
+        if (!replaced)
+            av_bprint_append_data(request, line, len);
+        line += len;
+    }
+    ff_mutex_unlock(&header_override_lock);
+}
