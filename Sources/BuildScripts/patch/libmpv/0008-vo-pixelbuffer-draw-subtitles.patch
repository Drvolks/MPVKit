+// IOSurface-backed buffer from a pool matching the frame, for frames that get
+// subtitles drawn on them.
+static CVPixelBufferRef pool_buffer(struct vo *vo, OSType fmt, int w, int h)
+{
+    struct priv *p = vo->priv;
+    if (!p->pool || p->pool_fmt != fmt || p->pool_w != w || p->pool_h != h) {
+        if (p->pool) {
+            CVPixelBufferPoolRelease(p->pool);
+            p->pool = NULL;
+        }
+        CFDictionaryRef io_attrs = CFDictionaryCreate(
+            kCFAllocatorDefault, NULL, NULL, 0,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        CFNumberRef cf_w = CFNumberCreate(NULL, kCFNumberIntType, &w);
+        CFNumberRef cf_h = CFNumberCreate(NULL, kCFNumberIntType, &h);
+        CFNumberRef cf_fmt = CFNumberCreate(NULL, kCFNumberSInt32Type, &fmt);
+        const void *keys[] = {
+            kCVPixelBufferIOSurfacePropertiesKey,
+            kCVPixelBufferWidthKey,
+            kCVPixelBufferHeightKey,
+            kCVPixelBufferPixelFormatTypeKey,
+        };
+        const void *vals[] = { io_attrs, cf_w, cf_h, cf_fmt };
+        CFDictionaryRef attrs = CFDictionaryCreate(
+            kCFAllocatorDefault, keys, vals, 4,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        CVReturn ret = CVPixelBufferPoolCreate(kCFAllocatorDefault, NULL, attrs, &p->pool);
+        CFRelease(attrs);
+        CFRelease(io_attrs);
+        CFRelease(cf_w);
+        CFRelease(cf_h);
+        CFRelease(cf_fmt);
+        if (ret != kCVReturnSuccess) {
+            MP_WARN(vo, "pixelbuffer: CVPixelBufferPoolCreate failed: %d\n", (int)ret);
+            p->pool = NULL;
+            return NULL;
+        }
+        p->pool_fmt = fmt;
+        p->pool_w = w;
+        p->pool_h = h;
+    }
+    CVPixelBufferRef pb = NULL;
+    if (CVPixelBufferPoolCreatePixelBuffer(kCFAllocatorDefault, p->pool, &pb) != kCVReturnSuccess)
+        return NULL;
     return pb;
+}
+
+// Copy of a VideoToolbox frame we are allowed to draw on.
+static CVPixelBufferRef copy_pixelbuffer(struct vo *vo, CVPixelBufferRef src)
+{
+    OSType fmt = CVPixelBufferGetPixelFormatType(src);
+    if (fmt != kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange &&
+        fmt != kCVPixelFormatType_420YpCbCr8BiPlanarFullRange &&
+        fmt != kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange)
+        return NULL;
+
+    int w = (int)CVPixelBufferGetWidth(src);
+    int h = (int)CVPixelBufferGetHeight(src);
+    CVPixelBufferRef dst = pool_buffer(vo, fmt, w, h);
+    if (!dst)
+        return NULL;
+
+    CVPixelBufferLockBaseAddress(src, kCVPixelBufferLock_ReadOnly);
+    CVPixelBufferLockBaseAddress(dst, 0);
+    for (size_t i = 0; i < CVPixelBufferGetPlaneCount(src); i++) {
+        uint8_t *s = CVPixelBufferGetBaseAddressOfPlane(src, i);
+        uint8_t *d = CVPixelBufferGetBaseAddressOfPlane(dst, i);
+        size_t s_stride = CVPixelBufferGetBytesPerRowOfPlane(src, i);
+        size_t d_stride = CVPixelBufferGetBytesPerRowOfPlane(dst, i);
+        size_t rows = CVPixelBufferGetHeightOfPlane(src, i);
+        size_t bytes = MPMIN(s_stride, d_stride);
+        for (size_t y = 0; y < rows; y++)
+            memcpy(d + y * d_stride, s + y * s_stride, bytes);
+    }
+    CVPixelBufferUnlockBaseAddress(dst, 0);
+    CVPixelBufferUnlockBaseAddress(src, kCVPixelBufferLock_ReadOnly);
+    CVBufferPropagateAttachments(src, dst);
+    return dst;
+}
+
+// Subtitles are authored for SDR: BT.1886 (gamma 2.4), white = 100%. Drawn as is into PQ/HLG
+// video, their code values would be read as PQ/HLG ones: white near the TV's peak. A plain
+// scale of the code values fixes white but darkens everything below it (a light grey PGS
+// subtitle ended up near 60 nits, grey and hard to read). So each 8-bit SDR value goes
+// through its light level instead: SDR white lands at SUB_HDR_WHITE_NITS and greys keep their
+// brightness relative to it. Works on private copies of the bitmaps, which belong to mpv's
+// subtitle renderer.
+#define SUB_HDR_WHITE_NITS 300.0
+
+static double pq_encode(double nits)
+{
+    const double m1 = 0.1593017578125, m2 = 78.84375;
+    const double c1 = 0.8359375, c2 = 18.8515625, c3 = 18.6875;
+    double y = pow(fmax(nits, 0.0) / 10000.0, m1);
+    return pow((c1 + c2 * y) / (1.0 + c3 * y), m2);
+}
+
+static double hlg_encode(double scene)
+{
+    const double a = 0.17883277, b = 0.28466892, c = 0.55991073;
+    return scene <= 1.0 / 12.0 ? sqrt(3.0 * scene) : a * log(12.0 * scene - b) + c;
+}
+
+// SDR code value -> PQ/HLG code value. False when the video is not HDR.
+static bool subtitle_tone_lut(struct mp_image_params *params, uint8_t lut[256])
+{
+    int trc = params->color.transfer;
+    if (trc != PL_COLOR_TRC_PQ && trc != PL_COLOR_TRC_HLG)
+        return false;
+    for (int v = 0; v < 256; v++) {
+        double linear = pow(v / 255.0, 2.4);
+        double out = trc == PL_COLOR_TRC_PQ
+            ? pq_encode(linear * SUB_HDR_WHITE_NITS)
+            : hlg_encode(linear * 0.2637);  // HLG reference white: 75% signal
+        lut[v] = (uint8_t)lrint(fmin(fmax(out, 0.0), 1.0) * 255.0);
+    }
+    return true;
 }
 
+static void tone_map_bitmaps(struct sub_bitmaps *b, const uint8_t lut[256])
+{
+    if (!b->packed)
+        return;
+    struct mp_image *copy = mp_image_new_copy(b->packed);
+    if (!copy)
+        return;
+    talloc_steal(b, copy);
+    talloc_free(b->packed);
+    b->packed = copy;
+
+    int bpp = b->format == SUBBITMAP_BGRA ? 4 : 1;
+    for (int n = 0; n < b->num_parts; n++) {
+        struct sub_bitmap *part = &b->parts[n];
+        part->bitmap = copy->planes[0] + part->src_y * copy->stride[0] + part->src_x * bpp;
+        part->stride = copy->stride[0];
+        if (b->format == SUBBITMAP_LIBASS) {
+            uint32_t c = part->libass.color; // 0xRRGGBBAA, AA = transparency
+            uint32_t r = lut[(c >> 24) & 0xff], g = lut[(c >> 16) & 0xff], bl = lut[(c >> 8) & 0xff];
+            part->libass.color = (r << 24) | (g << 16) | (bl << 8) | (c & 0xff);
+        }
+    }
+    if (b->format == SUBBITMAP_BGRA) {
+        // Premultiplied alpha: map the straight color, then premultiply again.
+        for (int y = 0; y < copy->h; y++) {
+            uint8_t *row = copy->planes[0] + y * copy->stride[0];
+            for (int x = 0; x < copy->w; x++) {
+                uint8_t *px = row + x * 4;
+                unsigned a = px[3];
+                if (!a)
+                    continue;
+                for (int i = 0; i < 3; i++) {
+                    unsigned straight = MPMIN(255u, (px[i] * 255u + a / 2) / a);
+                    px[i] = (uint8_t)((lut[straight] * a + 127) / 255);
+                }
+            }
+        }
+    }
+}
+
+static struct sub_bitmap_list *tone_mapped_copy(struct sub_bitmap_list *in, const uint8_t lut[256])
+{
+    struct sub_bitmap_list *out = talloc_zero(NULL, struct sub_bitmap_list);
+    out->change_id = in->change_id;
+    out->w = in->w;
+    out->h = in->h;
+    for (int n = 0; n < in->num_items; n++) {
+        struct sub_bitmaps *item = in->items[n];
+        struct sub_bitmaps *copy = item->packed ? sub_bitmaps_copy(NULL, item) : NULL;
+        if (copy) {
+            talloc_steal(out, copy);
+            tone_map_bitmaps(copy, lut);
+            item = copy;
+        }
+        MP_TARRAY_APPEND(out, out->items, out->num_items, item);
+    }
+    return out;
+}
+
+// Draw subtitles / OSD for this frame onto `pb` (locked by the caller).
+static void draw_subtitles(struct vo *vo, CVPixelBufferRef pb, struct mp_image *frame_img,
+                           struct sub_bitmap_list *sbs)
+{
+    struct priv *p = vo->priv;
+    int fmt;
+    switch (CVPixelBufferGetPixelFormatType(pb)) {
+    case kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange:
+    case kCVPixelFormatType_420YpCbCr8BiPlanarFullRange:
+        fmt = IMGFMT_NV12;
+        break;
+    case kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange:
+        fmt = IMGFMT_P010;
+        break;
+    default:
+        return;
+    }
+
+    struct mp_image dst = {0};
+    mp_image_setfmt(&dst, fmt);
+    mp_image_set_size(&dst, (int)CVPixelBufferGetWidth(pb), (int)CVPixelBufferGetHeight(pb));
+    dst.params.color = frame_img->params.color;
+    dst.params.repr = frame_img->params.repr;
+    for (int i = 0; i < 2; i++) {
+        dst.planes[i] = CVPixelBufferGetBaseAddressOfPlane(pb, i);
+        dst.stride[i] = (int)CVPixelBufferGetBytesPerRowOfPlane(pb, i);
+    }
+
+    if (!p->osd_cache)
+        p->osd_cache = mp_draw_sub_alloc(p, vo->global);
+
+    uint8_t lut[256];
+    bool hdr = subtitle_tone_lut(&frame_img->params, lut);
+    struct sub_bitmap_list *list = hdr ? tone_mapped_copy(sbs, lut) : sbs;
+    if (!mp_draw_sub_bitmaps(p->osd_cache, &dst, list))
+        MP_WARN(vo, "pixelbuffer: failed to draw subtitles\n");
+    if (list != sbs)
+        talloc_free(list);
+}
