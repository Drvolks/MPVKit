+// HDR10 static metadata (mastering display, content light levels), in the byte layout of the
+// HEVC SEI messages. AVPlayer hands them to the TV; without them the TV guesses the content's
+// brightness, and a TCL showed a 1000-nit remux very dark. Only what the file carries is
+// attached: zeros mean "unknown" and are left out.
+static void attach_hdr_metadata(CVPixelBufferRef pb, struct mp_image_params *params)
+{
+    if (params->color.transfer != PL_COLOR_TRC_PQ)
+        return;
+
+    const struct pl_hdr_metadata *hdr = &params->color.hdr;
+    const struct pl_raw_primaries *prim = &hdr->prim;
+    if (prim->red.x > 0 && prim->green.x > 0 && prim->blue.x > 0 && prim->white.x > 0 &&
+        hdr->max_luma > 0)
+    {
+        // Primaries in G, B, R order then white point, in 0.00002 units; luminance in
+        // 0.0001 cd/m².
+        const struct pl_cie_xy xy[4] = {prim->green, prim->blue, prim->red, prim->white};
+        uint8_t mdcv[24];
+        for (int i = 0; i < 4; i++) {
+            put_be16(mdcv + i * 4, xy[i].x * 50000.0);
+            put_be16(mdcv + i * 4 + 2, xy[i].y * 50000.0);
+        }
+        put_be32(mdcv + 16, hdr->max_luma * 10000.0);
+        put_be32(mdcv + 20, hdr->min_luma * 10000.0);
+        set_data_attachment(pb, kCVImageBufferMasteringDisplayColorVolumeKey, mdcv, sizeof(mdcv));
+    }
+
+    if (hdr->max_cll > 0) {
+        uint8_t clli[4];
+        put_be16(clli, hdr->max_cll);
+        put_be16(clli + 2, hdr->max_fall);
+        set_data_attachment(pb, kCVImageBufferContentLightLevelInfoKey, clli, sizeof(clli));
+    }
+}
+
