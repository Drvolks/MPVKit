+static void put_be16(uint8_t *p, double v)
+{
+    uint32_t x = v <= 0 ? 0 : v >= 65535 ? 65535 : (uint32_t)lrint(v);
+    p[0] = x >> 8;
+    p[1] = x;
+}
+
+static void put_be32(uint8_t *p, double v)
+{
+    uint32_t x = v <= 0 ? 0 : v >= 4294967295.0 ? 4294967295u : (uint32_t)llrint(v);
+    p[0] = x >> 24;
+    p[1] = x >> 16;
+    p[2] = x >> 8;
+    p[3] = x;
+}
+
+static void set_data_attachment(CVPixelBufferRef pb, CFStringRef key, const uint8_t *bytes,
+                                CFIndex len)
+{
+    CFDataRef data = CFDataCreate(kCFAllocatorDefault, bytes, len);
+    if (data) {
+        CVBufferSetAttachment(pb, key, data, kCVAttachmentMode_ShouldPropagate);
+        CFRelease(data);
+    }
+}
