+// AudioObjectRemovePropertyListener() does not guarantee that a notification
+// already queued before the call completes is cancelled, so hotplug_cb() can
+// still run after the owning `ao` has been uninit'd and freed (seen as a
+// SIGSEGV inside the callback on macOS 26/27 betas, where device-change
+// notifications appear to fire more often). This context is allocated once
+// and intentionally never freed: `valid` is cleared before the listener is
+// removed, so a late callback can detect the `ao` may be gone and bail out
+// instead of touching it, without racing the free of the context itself.
+struct coreaudio_hotplug_ctx {
+    struct ao *ao;
+    atomic_bool valid;
+};
